# 健康幣 HealthVault — 環境變數。複製為 .env 後可覆寫；啟動時自動載入（無相依套件）。
# FHIR_BASE_URL 為必填（無預設值），其餘變數皆有合理預設。

# 後端服務埠（預設 3100）
PORT=3100

# 目標 FHIR 伺服器（必填，無預設值）——請填入可連線且允許寫入的 FHIR R4 伺服器位址。
# 未設定時 npm start / npm run seed 會印出錯誤並中止（exit 1）。
# 範例（擇一，取消註解或直接填入下方）：
#   FHIR_BASE_URL=https://tzuchi-fhir.ddns.net/fhir   # 慈濟 FHIR 測試站
#   FHIR_BASE_URL=https://hapi.fhir.org/baseR4        # 公開 HAPI 測試站
FHIR_BASE_URL=

# 租戶標記：共用伺服器上以 _tag 過濾，只讀寫本平台資料。
# 多人共用同一伺服器時，請改成獨一無二的字串（例如加上學號）。
TENANT_TAG=healthvault-demo

# ── 發幣與消費規則（企劃書 6.1 / 附錄）──
STEPS_PER_COIN=1000        # 1,000 步 = 1 幣（無條件捨去）
AEROBIC_WEIGHT=1.2         # 有氧達標加權（上限 1.2）
AEROBIC_HR_MIN=90          # 有氧心率區間下限 bpm
AEROBIC_HR_MAX=160         # 有氧心率區間上限 bpm
DAILY_EARN_CAP=50          # 單日發幣上限
DAILY_SPEND_CAP=100        # 單日消費上限（靜態載具止損線）
ANTI_FRAUD_STEPS_PER_HOUR=15000   # 防偽：單次同步步/小時上限
DEFAULT_SYNC_WINDOW_HOURS=1        # 即時同步未帶時間窗時的保守假設

# 發卡管理端登入密碼（消費者/Kiosk/POS 端展示用免登入）
ADMIN_PASSWORD=health1234

# 健康物資白名單（可選；JSON 陣列，覆寫預設品項）
# CATALOG_JSON=[{"code":"VITD","name":"維生素 D3","price":8,"category":"營養品"}]
